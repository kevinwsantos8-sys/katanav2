    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*"
  },
  "mixins": [
    {
      "config": "shadowkatana.client.mixins.json",
      "environment": "client"
    }
  ]
